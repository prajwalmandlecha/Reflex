# Copy to .env and fill in real values. docker-compose reads .env automatically.
# NEVER commit .env — it contains secrets.

# Shared JWT secret used by BOTH backend (minting) and gateway (validation).
# Must match between the two services or agent tokens won't validate.
JWT_SECRET=change-me-to-a-long-random-string
JWT_ISSUER=agp-gateway

# Gateway only boots with the built-in dev secret when AGP_ENV=dev (fail-closed otherwise).
# The backend now also enforces this check.
AGP_ENV=dev

# Fernet key for encrypting bank-connection downstream credentials at rest.
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# The backend refuses to encrypt/decrypt without it (fail-loud, G10).
FERNET_KEY=